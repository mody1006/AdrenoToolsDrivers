from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.popup import Popup
from kivy.uix.scrollview import ScrollView
from kivy.uix.gridlayout import GridLayout
import requests

class MyApp(App):
    def build(self):
        # إنشاء الواجهة الرئيسية
        self.layout = BoxLayout(orientation='vertical', padding=10, spacing=10)

        # عنوان التطبيق
        self.title_label = Label(text="[b][color=#00FF00]مرحبًا بك في تطبيق لغتي![/color][/b]", markup=True, font_size=24)
        self.layout.add_widget(self.title_label)

        # زر النحو والإعراب
        self.grammar_button = Button(text="النحو والإعراب", size_hint=(1, 0.2), background_color=(0.2, 0.6, 1, 1))
        self.grammar_button.bind(on_press=self.open_grammar_section)
        self.layout.add_widget(self.grammar_button)

        # زر الإملاء والقواعد الإملائية
        self.spelling_button = Button(text="الإملاء والقواعد الإملائية", size_hint=(1, 0.2), background_color=(0.2, 0.6, 1, 1))
        self.spelling_button.bind(on_press=self.open_spelling_section)
        self.layout.add_widget(self.spelling_button)

        # زر الترجمة
        self.translation_button = Button(text="الترجمة", size_hint=(1, 0.2), background_color=(0.2, 0.6, 1, 1))
        self.translation_button.bind(on_press=self.open_translation_section)
        self.layout.add_widget(self.translation_button)

        # زر الذكاء الاصطناعي
        self.ai_button = Button(text="خدمة الذكاء الاصطناعي", size_hint=(1, 0.2), background_color=(0.2, 0.6, 1, 1))
        self.ai_button.bind(on_press=self.open_ai_service)
        self.layout.add_widget(self.ai_button)

        # زر الخروج
        self.exit_button = Button(text="الخروج", size_hint=(1, 0.2), background_color=(1, 0.2, 0.2, 1))
        self.exit_button.bind(on_press=self.exit_app)
        self.layout.add_widget(self.exit_button)

        return self.layout

    def open_grammar_section(self, instance):
        # نافذة منبثقة للنحو والإعراب
        content = BoxLayout(orientation='vertical', padding=10, spacing=10)
        label = Label(text="درس نحوي بسيط:\n- الجملة الاسمية تتكون من مبتدأ وخبر.\n- الجملة الفعلية تتكون من فعل وفاعل.")
        close_button = Button(text="إغلاق", size_hint=(1, 0.3), background_color=(1, 0.2, 0.2, 1))
        content.add_widget(label)
        content.add_widget(close_button)

        popup = Popup(title="النحو والإعراب", content=content, size_hint=(0.8, 0.6))
        close_button.bind(on_press=popup.dismiss)
        popup.open()

    def open_spelling_section(self, instance):
        # نافذة منبثقة للإملاء والقواعد الإملائية
        content = BoxLayout(orientation='vertical', padding=10, spacing=10)
        label = Label(text="درس إملائي بسيط:\n- التنوين هو إضافة نون ساكنة إلى نهاية الكلمة.\n- التاء المربوطة تُكتب بالهاء وتُنطق تاء عند الوصل.")
        close_button = Button(text="إغلاق", size_hint=(1, 0.3), background_color=(1, 0.2, 0.2, 1))
        content.add_widget(label)
        content.add_widget(close_button)

        popup = Popup(title="الإملاء والقواعد الإملائية", content=content, size_hint=(0.8, 0.6))
        close_button.bind(on_press=popup.dismiss)
        popup.open()

    def open_translation_section(self, instance):
        # نافذة منبثقة للترجمة
        content = BoxLayout(orientation='vertical', padding=10, spacing=10)
        self.text_input = TextInput(hint_text="أدخل النص هنا...", multiline=False)
        translate_button = Button(text="ترجم", size_hint=(1, 0.3), background_color=(0.2, 0.6, 1, 1))
        translate_button.bind(on_press=self.translate_text)
        content.add_widget(self.text_input)
        content.add_widget(translate_button)

        self.popup = Popup(title="خدمة الترجمة", content=content, size_hint=(0.8, 0.6))
        self.popup.open()

    def translate_text(self, instance):
        # استخدام Google Translate API للترجمة
        text = self.text_input.text
        if text.strip():
            try:
                translated_text = self.call_translation_api(text, "en")
                result_popup = Popup(title="نتيجة الترجمة", content=Label(text=f"النص المترجم: {translated_text}"), size_hint=(0.8, 0.4))
                result_popup.open()
            except Exception as e:
                error_popup = Popup(title="خطأ", content=Label(text="حدث خطأ أثناء الترجمة."), size_hint=(0.8, 0.4))
                error_popup.open()
        else:
            error_popup = Popup(title="خطأ", content=Label(text="الرجاء إدخال نص."), size_hint=(0.8, 0.4))
            error_popup.open()

    def call_translation_api(self, text, target_language):
        api_key = "YOUR_GOOGLE_TRANSLATE_API_KEY"
        url = "https://translation.googleapis.com/language/translate/v2"
        data = {
            "q": text,
            "target": target_language,
            "key": api_key
        }
        response = requests.post(url, data=data)
        if response.status_code == 200:
            result = response.json()["data"]["translations"][0]["translatedText"]
            return result
        else:
            raise Exception("خطأ في الاتصال بخدمة الترجمة.")

    def open_ai_service(self, instance):
        # نافذة منبثقة للذكاء الاصطناعي
        content = BoxLayout(orientation='vertical', padding=10, spacing=10)
        self.ai_input = TextInput(hint_text="أدخل سؤالك هنا...", multiline=False)
        ai_button = Button(text="إرسال", size_hint=(1, 0.3), background_color=(0.2, 0.6, 1, 1))
        ai_button.bind(on_press=self.get_ai_response)
        content.add_widget(self.ai_input)
        content.add_widget(ai_button)

        self.ai_popup = Popup(title="خدمة الذكاء الاصطناعي", content=content, size_hint=(0.8, 0.6))
        self.ai_popup.open()

    def get_ai_response(self, instance):
        # استخدام OpenAI API للحصول على إجابة
        question = self.ai_input.text
        if question.strip():
            try:
                response = self.call_ai_api(question)
                result_popup = Popup(title="إجابة الذكاء الاصطناعي", content=Label(text=f"الإجابة: {response}"), size_hint=(0.8, 0.4))
                result_popup.open()
            except Exception as e:
                error_popup = Popup(title="خطأ", content=Label(text="حدث خطأ أثناء البحث."), size_hint=(0.8, 0.4))
                error_popup.open()
        else:
            error_popup = Popup(title="خطأ", content=Label(text="الرجاء إدخال سؤال."), size_hint=(0.8, 0.4))
            error_popup.open()

    def call_ai_api(self, query):
        api_key = "YOUR_OPENAI_API_KEY"
        url = "https://api.openai.com/v1/engines/davinci/completions"
        headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        }
        data = {
            "prompt": query,
            "max_tokens": 100
        }

        response = requests.post(url, headers=headers, json=data)
        if response.status_code == 200:
            result = response.json()["choices"][0]["text"]
 return result.strip()
        else:
            raise Exception("خطأ في الاتصال بخدمة الذكاء الاصطناعي.")

    def exit_app(self, instance):
        # إغلاق التطبيق
        App.get_running_app().stop()

if __name__ == '__main__':
    MyApp().run()
